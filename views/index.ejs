<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <a href="/listings/new"><button>Add Item</button></a>
    
    <table border="2px solid">
        <tr>
            <th>Item</th>
            <th>Quentity</th>
            <th>Edit</th>
          
        </tr>
        <% for (let i of allItems){ %>
            <tr>
                <td> <%=i.item%> </td>
                <td> <%= i.quentity %> </td> 
                <td><form action="">
                    <input type="number" name="quentity">
                    <button>submit</button>
                </form></td>
                <!-- <td> <input type="number" name="quentity" ></td>
                <td><form action=""><button>submit</button></form></td> -->

            </tr>
        <% } %>
    </table>
</body>
</html>